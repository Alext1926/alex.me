---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort((a, b) =>
  a.localeCompare(b),
);
const locations = [...new Set(jobs.map((job) => job.location))].sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <section class="mb-6" aria-labelledby="role-filters-heading">
          <h3 id="role-filters-heading" class="text-lg font-medium text-slate-100 mb-3">
            Filter roles
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_1fr_auto] gap-4 items-end">
            <label class="block text-sm text-slate-300">
              Search by title
              <input
                type="search"
                class="mt-1 block w-full rounded border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                data-testid="role-search"
              />
            </label>
            <label class="block text-sm text-slate-300">
              Department
              <select
                class="mt-1 block w-full rounded border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                data-testid="department-filter"
              >
                <option value="">All departments</option>
                {departments.map((department) => <option value={department}>{department}</option>)}
              </select>
            </label>
            <label class="block text-sm text-slate-300">
              Location
              <select
                class="mt-1 block w-full rounded border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                data-testid="location-filter"
              >
                <option value="">All locations</option>
                {locations.map((location) => <option value={location}>{location}</option>)}
              </select>
            </label>
            <button
              type="button"
              class="rounded border border-slate-600 px-4 py-2 text-sm text-slate-200 hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
              data-testid="reset-filters"
            >
              Reset filters
            </button>
          </div>
        </section>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <p
          class="mt-6 text-sm text-slate-400"
          data-testid="filter-empty-state"
          role="status"
          aria-live="polite"
          hidden
        >
          No roles match your title search and selected filters. Try changing or resetting them.
        </p>
      </>
    )}
  </div>
</Layout>

<script>
  import { filterJobs, searchJobs } from '../lib/jobs';

  const rolesGrid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const roleSearch = document.querySelector<HTMLInputElement>('[data-testid="role-search"]');
  const departmentFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="department-filter"]',
  );
  const locationFilter = document.querySelector<HTMLSelectElement>(
    '[data-testid="location-filter"]',
  );
  const resetButton = document.querySelector<HTMLButtonElement>(
    '[data-testid="reset-filters"]',
  );
  const emptyState = document.querySelector<HTMLElement>(
    '[data-testid="filter-empty-state"]',
  );

  if (rolesGrid && roleSearch && departmentFilter && locationFilter && resetButton && emptyState) {
    const roleCards = Array.from(
      rolesGrid.querySelectorAll<HTMLElement>('[data-testid="role-card"]'),
    );
    const jobs = roleCards.map((card) => ({
      slug: card.dataset.jobId ?? '',
      department: card.dataset.department ?? '',
      location: card.dataset.location ?? '',
      title: card.dataset.title ?? '',
    }));

    const updateVisibleRoles = () => {
      const departmentAndLocationMatches = filterJobs(jobs, {
          department: departmentFilter.value,
          location: locationFilter.value,
        });
      const matchingSlugs = new Set(
        searchJobs(departmentAndLocationMatches, roleSearch.value).map((job) => job.slug),
      );

      roleCards.forEach((card) => {
        card.hidden = !matchingSlugs.has(card.dataset.jobId ?? '');
      });
      emptyState.hidden = matchingSlugs.size > 0;
    };

    roleSearch.addEventListener('input', updateVisibleRoles);
    departmentFilter.addEventListener('change', updateVisibleRoles);
    locationFilter.addEventListener('change', updateVisibleRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      roleSearch.value = '';
      updateVisibleRoles();
    });
  }
</script>
